{
  "$description": "Jatri design tokens. Source of truth for colours, type, spacing and shapes. Android mirrors these in core/designsystem/theme/*.kt.",
  "color": {
    "light": {
      "primary": "#0E7C86",
      "primaryDark": "#095A61",
      "primaryLight": "#E3F4F5",
      "accent": "#FF7A45",
      "onAccent": "#1A1F24",
      "flight": "#2D7FF9",
      "bus": "#1FA463",
      "train": "#B23A48",
      "success": "#16A34A",
      "warning": "#F59E0B",
      "warningText": "#B45309",
      "error": "#DC2626",
      "background": "#F7F9FA",
      "surface": "#FFFFFF",
      "textPrimary": "#1A1F24",
      "textSecondary": "#5B6670",
      "divider": "#E5E9EC",
      "topBar": "#0E7C86"
    },
    "dark": {
      "primary": "#3FB8C2",
      "accent": "#FF8F63",
      "onAccent": "#1A1F24",
      "flight": "#6EA8FF",
      "bus": "#4CC58A",
      "train": "#E0707D",
      "background": "#0F1416",
      "surface": "#1A2124",
      "textPrimary": "#ECEFF1",
      "textSecondary": "#A9B4BC",
      "divider": "#2C363A",
      "topBar": "#0B4A50"
    }
  },
  "typography": {
    "fontFamily": { "bangla": "Hind Siliguri", "latin": "Inter" },
    "display": { "size": 24, "weight": 600, "use": "prices on result cards" },
    "headline": { "size": 20, "weight": 600, "use": "screen titles" },
    "title": { "size": 16, "weight": 500, "use": "card titles, city names" },
    "body": { "size": 14, "weight": 400, "lineHeight": 1.5, "lineHeightBangla": 1.6 },
    "label": { "size": 12, "weight": 500 }
  },
  "spacing": { "base": 4, "scale": [4, 8, 12, 16, 24, 32], "screenPadding": 16, "touchTarget": 48, "buttonHeight": 52 },
  "radius": { "button": 12, "card": 16, "chip": 20, "sheetTop": 24 },
  "elevation": { "card": 1, "ticket": 2, "stickyBar": 8 },
  "motion": { "durationMs": [200, 300], "shimmerMs": 1100 }
}
