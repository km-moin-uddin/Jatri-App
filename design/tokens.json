{
  "$description": "Jatri design tokens (soft neutral style, v2). Source of truth for colours, type, spacing and shapes. Android mirrors these in core/designsystem/theme/*.kt.",
  "color": {
    "brand": {
      "teal": "#0E7C86",
      "tealDark": "#095A61",
      "tealLight": "#E3F4F5",
      "note": "logo, splash, small accents"
    },
    "light": {
      "canvas": "#ECEDEF",
      "card": "#F7F8F9",
      "cardHigh": "#FFFFFF",
      "cardBorder": "#FFFFFFCC",
      "pill": "#15181B",
      "onPill": "#FFFFFF",
      "cta": "#FF7A45",
      "onCta": "#15181B",
      "textPrimary": "#15181B",
      "textSecondary": "#5B6670",
      "divider": "#DCDFE3",
      "flight": "#2D7FF9",
      "bus": "#1FA463",
      "train": "#B23A48",
      "success": "#15803D",
      "warningText": "#B45309",
      "error": "#DC2626"
    },
    "dark": {
      "canvas": "#111315",
      "card": "#1C1F22",
      "cardHigh": "#262A2E",
      "cardBorder": "#FFFFFF14",
      "pill": "#F2F3F4",
      "onPill": "#15181B",
      "cta": "#FF8F63",
      "onCta": "#15181B",
      "textPrimary": "#ECEFF1",
      "textSecondary": "#A3ABB3",
      "divider": "#2E3337",
      "flight": "#6EA8FF",
      "bus": "#4CC58A",
      "train": "#E0707D"
    }
  },
  "typography": {
    "fontFamily": {
      "bangla": "Hind Siliguri",
      "latinText": "Inter",
      "latinDisplay": "Plus Jakarta Sans"
    },
    "displayMedium": {
      "size": 32,
      "weight": 800,
      "use": "home headline"
    },
    "displaySmall": {
      "size": 28,
      "weight": 700,
      "use": "tab screen titles"
    },
    "headlineSmall": {
      "size": 20,
      "weight": 700,
      "use": "section titles, times, prices"
    },
    "title": {
      "size": 16,
      "weight": 600
    },
    "body": {
      "size": 14,
      "weight": 400,
      "lineHeight": 1.5,
      "lineHeightBangla": 1.6
    },
    "label": {
      "size": 12,
      "weight": 500
    }
  },
  "spacing": {
    "base": 4,
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32
    ],
    "screenPadding": 16,
    "touchTarget": 48,
    "buttonHeight": 52
  },
  "radius": {
    "pill": "50%",
    "card": 24,
    "cardSmall": 18,
    "field": 18,
    "sheetTop": 28
  },
  "elevation": {
    "card": 0,
    "cardBorder": 1,
    "bottomNav": 10,
    "stickyBar": 12
  },
  "motion": {
    "durationMs": [
      200,
      300
    ],
    "shimmerMs": 1100
  }
}
