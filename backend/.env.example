# Copy to .env and fill in. Never commit .env.
JATRI_ENV=dev                      # dev | test | prod
JATRI_DATABASE_URL=postgresql+asyncpg://jatri:jatri@localhost:5432/jatri
# Long random value in production: openssl rand -hex 32
JATRI_SECRET_KEY=change-me
JATRI_ACCESS_TOKEN_MINUTES=15
JATRI_REFRESH_TOKEN_DAYS=30

# OTP
JATRI_OTP_TTL_SECONDS=300
JATRI_OTP_MAX_ATTEMPTS=5
JATRI_OTP_MAX_SENDS_PER_WINDOW=3
JATRI_OTP_SEND_WINDOW_SECONDS=600
JATRI_OTP_RESEND_COOLDOWN_SECONDS=60
# DEV ONLY - every OTP becomes this code. Refused when JATRI_ENV=prod.
JATRI_DEV_FIXED_OTP=123456
# 11-character hash of the signed Android app, appended to the OTP SMS for auto-read.
JATRI_ANDROID_APP_HASH=

# SMS gateway: "console" prints the SMS to the log (dev). A real BD gateway adapter comes later.
JATRI_SMS_PROVIDER=console
# JATRI_SMS_API_KEY=            # for the real gateway, set as a secret in your deploy platform
