# Copy to .env and fill in. Never commit .env.
JATRI_ENV=dev                      # dev | test | prod
JATRI_DATABASE_URL=postgresql+asyncpg://jatri:jatri@localhost:5432/jatri
# Long random value in production: openssl rand -hex 32
JATRI_SECRET_KEY=change-me
JATRI_ACCESS_TOKEN_MINUTES=15
JATRI_REFRESH_TOKEN_DAYS=30

# OTP
JATRI_OTP_TTL_SECONDS=300
JATRI_OTP_MAX_ATTEMPTS=5
JATRI_OTP_MAX_SENDS_PER_WINDOW=3
JATRI_OTP_SEND_WINDOW_SECONDS=600
JATRI_OTP_RESEND_COOLDOWN_SECONDS=60
# DEV ONLY - every OTP becomes this code. Refused when JATRI_ENV=prod.
JATRI_DEV_FIXED_OTP=123456
# 11-character hash of the signed Android app, appended to the OTP SMS for auto-read.
JATRI_ANDROID_APP_HASH=

# Redis: search cache + seat-hold locks (required in prod)
JATRI_REDIS_URL=redis://localhost:6379/0
# Fernet key for NID/passport encryption (required in prod):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JATRI_DATA_KEY=
JATRI_HOLD_MINUTES=10

# Payments: "mock" (built-in sandbox checkout page) or "sslcommerz"
JATRI_PAYMENT_GATEWAY=mock
JATRI_SSLCOMMERZ_SANDBOX=true
JATRI_SSLCOMMERZ_STORE_ID=
# JATRI_SSLCOMMERZ_STORE_PASSWORD=   # secret: set in your deploy platform, never commit
# Public URL of this API (gateways call back here) and the app's return link
JATRI_PUBLIC_BASE_URL=http://localhost:8000
JATRI_APP_RETURN_URL=jatri://payment/return

# SMS gateway: "console" prints the SMS to the log (dev). A real BD gateway adapter comes later.
JATRI_SMS_PROVIDER=console
# JATRI_SMS_API_KEY=            # for the real gateway, set as a secret in your deploy platform

# Push (FCM HTTP v1). "console" only logs. JATRI_FCM_SERVICE_ACCOUNT is a SECRET (the service-account
# JSON or a path to it): set it in the deploy platform, never commit it.
JATRI_PUSH_PROVIDER=console
# JATRI_FCM_PROJECT_ID=
# JATRI_FCM_SERVICE_ACCOUNT=

# E-mail with the PDF ticket. "console" only logs.
JATRI_EMAIL_PROVIDER=console
# JATRI_SMTP_HOST=
# JATRI_SMTP_PORT=587
# JATRI_SMTP_USER=
# JATRI_SMTP_PASSWORD=
# JATRI_EMAIL_FROM=Jatri <tickets@example.com>
