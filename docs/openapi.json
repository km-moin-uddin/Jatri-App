                            }
                        ]
                    }
                },
                "type": "object",
                "required": [
                    "success"
                ],
                "title": "Envelope[OtpSendOut]"
            },
            "Envelope_TokenPair_": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "title": "Success"
                    },
                    "data": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/TokenPair"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "error": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/ApiError"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "type": "object",
                "required": [
                    "success"
                ],
                "title": "Envelope[TokenPair]"
            },
            "Envelope_UserOut_": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "title": "Success"
                    },
                    "data": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/UserOut"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "error": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/ApiError"
                            },
