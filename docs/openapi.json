                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "LocationOut": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type"
                    },
                    "code": {
                        "type": "string",
                        "title": "Code"
                    },
                    "name_en": {
                        "type": "string",
                        "title": "Name En"
                    },
                    "name_bn": {
                        "type": "string",
                        "title": "Name Bn"
                    },
                    "city_en": {
                        "type": "string",
                        "title": "City En"
                    },
                    "city_bn": {
                        "type": "string",
                        "title": "City Bn"
                    },
                    "country": {
                        "type": "string",
                        "title": "Country"
                    },
                    "is_popular": {
                        "type": "boolean",
                        "title": "Is Popular"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "type",
                    "code",
                    "name_en",
                    "name_bn",
                    "city_en",
                    "city_bn",
                    "country",
                    "is_popular"
                ],
                "title": "LocationOut"
            },
            "LogoutIn": {
                "properties": {
                    "refresh_token": {
                        "type": "string",
                        "maxLength": 200,
                        "minLength": 20,
                        "title": "Refresh Token"
                    }
                },
                "type": "object",
                "required": [
                    "refresh_token"
                ],
                "title": "LogoutIn"
            },
            "OtpSendIn": {
                "properties": {
                    "phone": {
                        "type": "string",
                        "maxLength": 20,
                        "minLength": 10,
                        "title": "Phone",
                        "examples": [
                            "01712345678"
                        ]
                    }
                },
                "type": "object",
                "required": [
                    "phone"
                ],
                "title": "OtpSendIn"
            },
            "OtpSendOut": {
                "properties": {
                    "phone": {
                        "type": "string",
                        "title": "Phone"
                    },
                    "expires_in": {
                        "type": "integer",
                        "title": "Expires In"
                    },
                    "resend_after": {
                        "type": "integer",
                        "title": "Resend After"
                    }
                },
                "type": "object",
                "required": [
                    "phone",
                    "expires_in",
                    "resend_after"
                ],
                "title": "OtpSendOut"
            },
            "OtpVerifyIn": {
                "properties": {
                    "phone": {
                        "type": "string",
                        "maxLength": 20,
                        "minLength": 10,
                        "title": "Phone"
                    },
                    "code": {
                        "type": "string",
                        "pattern": "^\\d{4,8}$",
                        "title": "Code"
                    },
                    "device_info": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 200
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Device Info"
                    }
                },
                "type": "object",
                "required": [
                    "phone",
                    "code"
                ],
                "title": "OtpVerifyIn"
            },
            "RefreshIn": {
                "properties": {
                    "refresh_token": {
                        "type": "string",
                        "maxLength": 200,
                        "minLength": 20,
                        "title": "Refresh Token"
                    }
                },
                "type": "object",
                "required": [
                    "refresh_token"
                ],
                "title": "RefreshIn"
            },
            "TokenPair": {
                "properties": {
                    "access_token": {
                        "type": "string",
                        "title": "Access Token"
                    },
                    "refresh_token": {
                        "type": "string",
                        "title": "Refresh Token"
                    },
                    "token_type": {
                        "type": "string",
                        "title": "Token Type",
                        "default": "bearer"
                    },
                    "expires_in": {
                        "type": "integer",
                        "title": "Expires In"
                    }
                },
                "type": "object",
                "required": [
                    "access_token",
                    "refresh_token",
                    "expires_in"
                ],
                "title": "TokenPair"
            },
            "UserOut": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Id"
                    },
                    "phone": {
                        "type": "string",
                        "title": "Phone"
                    },
                    "name": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Name"
                    },
                    "email": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Email"
                    },
                    "language": {
                        "type": "string",
                        "title": "Language"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "phone",
                    "name",
                    "email",
                    "language"
                ],
                "title": "UserOut"
            },
            "UserUpdateIn": {
                "properties": {
                    "name": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 80,
                                "minLength": 1
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Name"
                    },
                    "email": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "email"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Email"
                    },
                    "language": {
                        "anyOf": [
                            {
                                "type": "string",
                                "pattern": "^(bn|en)$"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Language"
                    }
                },
                "type": "object",
                "title": "UserUpdateIn"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
