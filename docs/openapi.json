{
    "openapi": "3.1.0",
    "info": {
        "title": "Jatri API",
        "description": "Flight, bus and train ticket booking for Bangladesh. All responses use the `{success, data, error}` envelope.",
        "version": "0.2.0"
    },
    "paths": {
        "/api/v1/auth/otp/send": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Send Otp",
                "operationId": "send_otp_api_v1_auth_otp_send_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OtpSendIn"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Envelope_OtpSendOut_"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/otp/verify": {
            "post": {
                "tags": [
