                    },
                    "message_bn": {
                        "type": "string",
                        "title": "Message Bn"
                    }
                },
                "type": "object",
                "required": [
                    "code",
                    "message_en",
                    "message_bn"
                ],
                "title": "ApiError"
            },
            "AuthOut": {
                "properties": {
                    "tokens": {
                        "$ref": "#/components/schemas/TokenPair"
                    },
                    "user": {
                        "$ref": "#/components/schemas/UserOut"
                    },
                    "is_new_user": {
                        "type": "boolean",
