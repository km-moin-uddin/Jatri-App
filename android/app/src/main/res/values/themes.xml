<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat base is required for per-app language switching (AppCompatDelegate). -->
    <style name="Theme.Jatri" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/jatri_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ SplashScreen API (backported by core-splashscreen): teal + centred icon. -->
    <style name="Theme.Jatri.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/jatri_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Jatri</item>
    </style>
</resources>
