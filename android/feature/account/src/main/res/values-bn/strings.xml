    <string name="account_faq1_q">টিকিট কীভাবে পাব?</string>
    <string name="account_faq1_a">পেমেন্টের পর ই-টিকিট আমার যাত্রায় দেখাবে এবং এসএমএস ও ইমেইলে পাঠানো হবে। ইন্টারনেট ছাড়াও এটি খোলা যাবে।</string>
    <string name="account_faq2_q">রিফান্ড কীভাবে হয়?</string>
    <string name="account_faq2_a">বাতিলের আগেই ভাড়ার নিয়ম অনুযায়ী সঠিক রিফান্ডের পরিমাণ দেখানো হবে। টাকা একই পেমেন্ট পদ্ধতিতে ফেরত যাবে।</string>
    <string name="account_faq3_q">ট্রেনের টিকিটে এনআইডি কেন লাগে?</string>
    <string name="account_faq3_a">বাংলাদেশ রেলওয়ে নিবন্ধিত এনআইডির বিপরীতে টিকিট দেয়, তাই প্রত্যেক প্রাপ্তবয়স্ক যাত্রীর এনআইডি লাগবে।</string>
